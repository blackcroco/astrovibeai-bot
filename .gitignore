# ==========================================
# AstroVibe - Production Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db

# Local logs
*.log

# Local database / temporary files
*.sqlite
*.sqlite3
*.db
*.tmp
*.temp

# Local credential files
credentials.json
service-account.json
service_account.json
